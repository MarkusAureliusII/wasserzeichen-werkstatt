# Logo, Aufschriften und Nutzdaten bleiben lokal
wasserzeichen.png
beschriftung.json
einstellungen.json
.laeuft
input/
output/

# Windows-Bau: mitgelieferte Fremdprogramme (zu groß fürs Repo)
windows/werkzeuge/

# Kundendaten fürs fertige Setup. Nur diese zwei Dateien, sonst nichts —
# mit "windows/daten/" ließe sich darin nichts wieder einschließen.
windows/daten/*
!windows/daten/wasserzeichen.png
!windows/daten/beschriftung.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Build-Ergebnisse
build/
dist/

# PyInstaller-Specs sind generiert — außer unserer gepflegten
*.spec
!windows/wasserzeichen.spec

# macOS
.DS_Store
